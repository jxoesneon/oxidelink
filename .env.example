# OxideLink environment variables required for release signing.
# Copy this file to .env and fill in real values; .env is gitignored.

# Password for the self-signed code-signing PFX used by scripts/sign-tauri.ps1.
OXIDELINK_PFX_PASSWORD=

# Tauri updater signing keypair. Leave empty to fall back to the local
# generated keypair in src-tauri/target (which is also gitignored).
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
