{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OxideLink",
  "version": "0.2.0",
  "identifier": "com.oxidelink.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OxideLink",
        "width": 960,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "transparent": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self' ws://localhost:9001 http://localhost:9001"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "bundle/nsis/HidHideInstaller.exe": "resources/drivers/HidHideInstaller.exe",
      "bundle/nsis/ViGEmBusSetup.exe": "resources/drivers/ViGEmBusSetup.exe"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./bundle/nsis/installer.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1QzVBODFDOUM3NDNDREQKUldUZFBIU2NIS2pGbFU5c3ErU0U5cFZXNnRNMGo4SXE4SnF2Yzd2b1ZRMFM5TGY4NDArRDNEQXcK",
      "endpoints": [
        "https://github.com/jxoesneon/oxidelink/releases/latest/download/latest.json"
      ]
    }
  }
}